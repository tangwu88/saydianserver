NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://saydian_app:change-me@postgres:5432/saydian_app?schema=public
REDIS_URL=redis://redis:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-an-independent-random-secret
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-before-first-run
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员
CORS_ORIGINS=http://localhost:3301,http://localhost:8080
MALL_BASE_URL=https://stest.saydian.cn/api/saidian-mall/v1
MALL_SERVICE_TOKEN=
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=saydian-app-private
OBJECT_STORAGE_ACCESS_KEY=saydian-local
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=true
PUSH_PROVIDER=disabled
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
SMS_PROVIDER=disabled
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
LEGACY_DATABASE_URL=
LEGACY_ATTACHMENT_ROOT=
MIGRATION_MAP_PATH=/app/migration-map.json
MIGRATION_REPORT_PATH=/app/artifacts/migration-report.json
LEGACY_TOKEN_EXCHANGE_ENABLED=false
MAINTENANCE_READ_ONLY=false
