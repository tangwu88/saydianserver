{
  "name": "saydian-us",
  "services": {
    "us-postgres": {
      "image": "postgres:16-alpine",
      "mem_limit": "256m",
      "cpus": 0.5,
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": [
        "us_private"
      ],
      "environment": {
        "POSTGRES_DB": "saydian_us",
        "POSTGRES_USER": "us_owner",
        "POSTGRES_PASSWORD": "${US_OWNER_PASSWORD:?Set independent owner password}"
      },
      "volumes": [
        "us_postgres:/var/lib/postgresql/data"
      ],
      "command": [
        "postgres",
        "-c",
        "shared_buffers=32MB",
        "-c",
        "max_connections=20",
        "-c",
        "work_mem=2MB"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U us_owner -d saydian_us"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 20
      }
    },
    "us-redis": {
      "image": "redis:7.2-alpine",
      "mem_limit": "64m",
      "cpus": 0.25,
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": [
        "us_private"
      ],
      "environment": {
        "REDIS_PASSWORD": "${US_REDIS_PASSWORD:?Set independent Redis password}"
      },
      "command": [
        "sh",
        "-ec",
        "exec redis-server --appendonly yes --maxmemory 32mb --maxmemory-policy noeviction --requirepass \"$$REDIS_PASSWORD\""
      ],
      "volumes": [
        "us_redis:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 20
      }
    },
    "us-minio": {
      "image": "${US_MINIO_IMAGE:?Use CI-verified immutable US storage image}",
      "mem_limit": "192m",
      "cpus": 0.25,
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": [
        "us_private"
      ],
      "environment": {
        "MINIO_ROOT_USER": "${US_MINIO_ROOT_USER:?Set independent storage administrator}",
        "MINIO_ROOT_PASSWORD": "${US_MINIO_ROOT_PASSWORD:?Set independent storage administrator password}"
      },
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "volumes": [
        "us_files:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "sh",
          "-ec",
          "wget -qO- http://127.0.0.1:9000/minio/health/ready >/dev/null"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 20
      },
      "read_only": true,
      "tmpfs": [
        "/tmp:size=16m,mode=1777"
      ]
    },
    "us-api": {
      "image": "${US_API_IMAGE:?Use verified immutable release image}",
      "mem_limit": "384m",
      "cpus": 0.5,
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": {
        "us_private": {
          "aliases": [
            "unified-api"
          ]
        },
        "us_egress": {}
      },
      "read_only": true,
      "tmpfs": [
        "/tmp:size=32m,mode=1777"
      ],
      "environment": {
        "NODE_ENV": "production",
        "DEPLOYMENT_SITE": "us",
        "PUBLIC_BASE_URL": "https://app.saydian.com",
        "CORS_ORIGINS": "https://app.saydian.com",
        "AUTH_ISSUER": "saydian-global-server",
        "AUTH_AUDIENCE": "saydian-global-app",
        "DATABASE_URL": "postgresql://us_app:${US_DATABASE_PASSWORD:?Set independent runtime password}@us-postgres:5432/saydian_us?schema=public&connection_limit=3",
        "REDIS_URL": "redis://:${US_REDIS_PASSWORD:?Set independent Redis password}@us-redis:6379",
        "ACCESS_TOKEN_SECRET": "${US_ACCESS_TOKEN_SECRET:?Set independent US signing key}",
        "REFRESH_TOKEN_PEPPER": "${US_REFRESH_TOKEN_PEPPER:?Set independent US refresh pepper}",
        "FIELD_ENCRYPTION_KEY": "${US_FIELD_ENCRYPTION_KEY:?Set independent US field key}",
        "INTEGRATION_MASTER_KEY": "${US_INTEGRATION_MASTER_KEY:?Set independent US integration key}",
        "OBJECT_STORAGE_ENDPOINT": "http://us-minio:9000",
        "OBJECT_STORAGE_ACCESS_KEY": "${US_BUCKET_ACCESS_KEY:?Set independent least-privilege bucket key}",
        "OBJECT_STORAGE_SECRET_KEY": "${US_BUCKET_SECRET_KEY:?Set independent bucket secret}",
        "OBJECT_STORAGE_BUCKET": "saydian-us-private",
        "OBJECT_STORAGE_FORCE_PATH_STYLE": "true",
        "COMMERCE_STOREFRONT_URL": "https://app.saydian.com/global/saidian-mall/",
        "GLOBAL_DOWNLOAD_URL": "https://app.saydian.com/global/down",
        "MAINTENANCE_READ_ONLY": "${US_MAINTENANCE_READ_ONLY:-true}",
        "BUSINESS_WRITES_PAUSED": "${US_BUSINESS_WRITES_PAUSED:-true}",
        "MAINTENANCE_ALLOW_MEMBER_AUTH": "false",
        "WORKER_OUTBOUND_PAUSED": "${US_WORKER_OUTBOUND_PAUSED:-true}",
        "CALLBACK_PROCESSING_PAUSED": "true",
        "LEGACY_SESSION_BRIDGE_ENABLED": "false",
        "LEGACY_TOKEN_EXCHANGE_ENABLED": "false",
        "ALLOW_TEST_OTP": "false",
        "SMS_PROVIDER": "disabled",
        "GLOBAL_EMAIL_PROVIDER": "disabled",
        "GLOBAL_SMS_PROVIDER": "disabled",
        "GLOBAL_UNVERIFIED_REGISTRATION_ENABLED": "${US_UNVERIFIED_REGISTRATION_ENABLED:-false}",
        "PUSH_PROVIDER": "disabled",
        "AI_PROVIDER": "disabled",
        "ENABLE_HEALTH_REPORT_SALES": "false",
        "REPORT_WORKER_CONCURRENCY": "1",
        "JUSHUITAN_OUTBOUND_ENABLED": "false",
        "GLOBAL_WECHAT_H5_ENABLED": "false",
        "GLOBAL_WECHAT_PHONE_TEST_ENABLED": "false",
        "APP_REVISION": "${US_REVISION:?Use verified revision}",
        "NODE_OPTIONS": "--max-old-space-size=256",
        "PORT": "8080"
      },
      "command": [
        "node",
        "dist/main.js"
      ],
      "ports": [
        "127.0.0.1:18180:8080"
      ],
      "depends_on": {
        "us-postgres": {
          "condition": "service_healthy"
        },
        "us-redis": {
          "condition": "service_healthy"
        },
        "us-minio": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:8080/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 20
      }
    },
    "us-worker": {
      "image": "${US_WORKER_IMAGE:?Use verified immutable release image}",
      "mem_limit": "192m",
      "cpus": 0.25,
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": [
        "us_private",
        "us_egress"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:size=32m,mode=1777"
      ],
      "environment": {
        "NODE_ENV": "production",
        "DEPLOYMENT_SITE": "us",
        "PUBLIC_BASE_URL": "https://app.saydian.com",
        "CORS_ORIGINS": "https://app.saydian.com",
        "AUTH_ISSUER": "saydian-global-server",
        "AUTH_AUDIENCE": "saydian-global-app",
        "DATABASE_URL": "postgresql://us_app:${US_DATABASE_PASSWORD:?Set independent runtime password}@us-postgres:5432/saydian_us?schema=public&connection_limit=3",
        "REDIS_URL": "redis://:${US_REDIS_PASSWORD:?Set independent Redis password}@us-redis:6379",
        "ACCESS_TOKEN_SECRET": "${US_ACCESS_TOKEN_SECRET:?Set independent US signing key}",
        "REFRESH_TOKEN_PEPPER": "${US_REFRESH_TOKEN_PEPPER:?Set independent US refresh pepper}",
        "FIELD_ENCRYPTION_KEY": "${US_FIELD_ENCRYPTION_KEY:?Set independent US field key}",
        "INTEGRATION_MASTER_KEY": "${US_INTEGRATION_MASTER_KEY:?Set independent US integration key}",
        "OBJECT_STORAGE_ENDPOINT": "http://us-minio:9000",
        "OBJECT_STORAGE_ACCESS_KEY": "${US_BUCKET_ACCESS_KEY:?Set independent least-privilege bucket key}",
        "OBJECT_STORAGE_SECRET_KEY": "${US_BUCKET_SECRET_KEY:?Set independent bucket secret}",
        "OBJECT_STORAGE_BUCKET": "saydian-us-private",
        "OBJECT_STORAGE_FORCE_PATH_STYLE": "true",
        "COMMERCE_STOREFRONT_URL": "https://app.saydian.com/global/saidian-mall/",
        "GLOBAL_DOWNLOAD_URL": "https://app.saydian.com/global/down",
        "MAINTENANCE_READ_ONLY": "${US_MAINTENANCE_READ_ONLY:-true}",
        "BUSINESS_WRITES_PAUSED": "${US_BUSINESS_WRITES_PAUSED:-true}",
        "MAINTENANCE_ALLOW_MEMBER_AUTH": "false",
        "WORKER_OUTBOUND_PAUSED": "${US_WORKER_OUTBOUND_PAUSED:-true}",
        "CALLBACK_PROCESSING_PAUSED": "true",
        "LEGACY_SESSION_BRIDGE_ENABLED": "false",
        "LEGACY_TOKEN_EXCHANGE_ENABLED": "false",
        "ALLOW_TEST_OTP": "false",
        "SMS_PROVIDER": "disabled",
        "GLOBAL_EMAIL_PROVIDER": "disabled",
        "GLOBAL_SMS_PROVIDER": "disabled",
        "GLOBAL_UNVERIFIED_REGISTRATION_ENABLED": "${US_UNVERIFIED_REGISTRATION_ENABLED:-false}",
        "PUSH_PROVIDER": "disabled",
        "AI_PROVIDER": "disabled",
        "ENABLE_HEALTH_REPORT_SALES": "false",
        "REPORT_WORKER_CONCURRENCY": "1",
        "JUSHUITAN_OUTBOUND_ENABLED": "false",
        "GLOBAL_WECHAT_H5_ENABLED": "false",
        "GLOBAL_WECHAT_PHONE_TEST_ENABLED": "false",
        "APP_REVISION": "${US_REVISION:?Use verified revision}",
        "NODE_OPTIONS": "--max-old-space-size=128"
      },
      "command": [
        "node",
        "dist/main.js"
      ],
      "depends_on": {
        "us-api": {
          "condition": "service_healthy"
        }
      }
    },
    "us-admin": {
      "image": "${US_ADMIN_IMAGE:?Use verified immutable release image}",
      "mem_limit": "64m",
      "cpus": 0.25,
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "networks": [
        "us_private"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:size=16m,mode=1777",
        "/var/cache/nginx:size=16m",
        "/var/run:size=1m"
      ],
      "depends_on": {
        "us-api": {
          "condition": "service_healthy"
        }
      },
      "ports": [
        "127.0.0.1:18181:8080"
      ],
      "volumes": [
        "/opt/saydian-us/downloads:/usr/share/nginx/html/down/files:ro"
      ]
    },
    "us-minio-init": {
      "image": "${US_MC_IMAGE:?Use CI-verified immutable US storage client image}",
      "profiles": [
        "bootstrap"
      ],
      "mem_limit": "64m",
      "cpus": 0.25,
      "pids_limit": 60,
      "networks": [
        "us_private"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:size=8m",
        "/root/.mc:size=8m"
      ],
      "restart": "no",
      "environment": {
        "MINIO_ROOT_USER": "${US_MINIO_ROOT_USER:?Set independent storage administrator}",
        "MINIO_ROOT_PASSWORD": "${US_MINIO_ROOT_PASSWORD:?Set independent storage administrator password}",
        "BUCKET_ACCESS_KEY": "${US_BUCKET_ACCESS_KEY:?Set independent bucket key}",
        "BUCKET_SECRET_KEY": "${US_BUCKET_SECRET_KEY:?Set independent bucket secret}"
      },
      "depends_on": {
        "us-minio": {
          "condition": "service_healthy"
        }
      },
      "entrypoint": [
        "/bin/sh",
        "-ec"
      ],
      "command": [
        "mc alias set local http://us-minio:9000 \"$$MINIO_ROOT_USER\" \"$$MINIO_ROOT_PASSWORD\" >/dev/null; mc mb --ignore-existing local/saydian-us-private >/dev/null; mc anonymous set none local/saydian-us-private >/dev/null; printf '%s' '{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucket\"],\"Resource\":[\"arn:aws:s3:::saydian-us-private\"]},{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\",\"s3:PutObject\",\"s3:DeleteObject\"],\"Resource\":[\"arn:aws:s3:::saydian-us-private/*\"]}]}' > /tmp/policy.json; mc admin user add local \"$$BUCKET_ACCESS_KEY\" \"$$BUCKET_SECRET_KEY\" >/dev/null; mc admin policy create local saydian-us-app /tmp/policy.json >/dev/null; mc admin policy attach local saydian-us-app --user \"$$BUCKET_ACCESS_KEY\" >/dev/null"
      ]
    }
  },
  "networks": {
    "us_private": {
      "internal": true
    },
    "us_egress": {}
  },
  "volumes": {
    "us_postgres": {},
    "us_redis": {},
    "us_files": {}
  }
}
