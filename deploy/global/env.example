# Template only. Keep the filled copy outside Git; never reuse domestic secrets.
GLOBAL_IMAGE_TAG=replace-with-verified-full-commit-sha
GLOBAL_APP_REVISION=replace-with-verified-full-commit-sha
GLOBAL_GATEWAY_NETWORK=replace-with-existing-gateway-network
GLOBAL_POSTGRES_OWNER_PASSWORD=replace-with-independent-random-password
GLOBAL_DATABASE_PASSWORD=replace-with-independent-url-safe-random-password
GLOBAL_REDIS_PASSWORD=replace-with-independent-url-safe-random-password
GLOBAL_MINIO_ROOT_USER=global-storage-admin
GLOBAL_MINIO_ROOT_PASSWORD=replace-with-independent-random-password
GLOBAL_OBJECT_STORAGE_ACCESS_KEY=replace-with-dedicated-bucket-user
GLOBAL_OBJECT_STORAGE_SECRET_KEY=replace-with-independent-bucket-user-secret
GLOBAL_ACCESS_TOKEN_SECRET=replace-with-independent-random-secret-at-least-32-characters
GLOBAL_EMPLOYEE_TOKEN_SECRET=replace-with-independent-random-secret-at-least-32-characters
GLOBAL_REFRESH_TOKEN_PEPPER=replace-with-independent-random-secret-at-least-32-characters
GLOBAL_FIELD_ENCRYPTION_KEY=replace-with-independent-base64-32-byte-key
GLOBAL_INTEGRATION_MASTER_KEY=replace-with-independent-base64-32-byte-key
# International H5 is served by the independent static admin image. Download is reserved.
GLOBAL_STOREFRONT_URL=https://app.saydian.cn/global/saidian-mall/
# Enable only after the H5 callback route, reviewed legal documents and account
# verification policy pass acceptance. Credentials stay encrypted in the admin.
GLOBAL_WECHAT_H5_ENABLED=false
GLOBAL_DOWNLOAD_URL=https://app.saydian.cn/global/down
GLOBAL_EMAIL_PROVIDER=disabled
GLOBAL_SMS_PROVIDER=disabled
# Temporary WeChat H5 phone-entry testing only. Does not verify phone ownership.
# Does not enable App OTP, password recovery, payments or Worker outbound calls.
# This temporary release defaults to true only when the private key is absent.
# Keep this explicit false for new deployments; false also disables issued test sessions.
GLOBAL_WECHAT_PHONE_TEST_ENABLED=false
# QA-only switches. Keep the safe defaults unless the isolated global database
# and reviewed legal documents are ready for an explicitly approved test.
GLOBAL_MAINTENANCE_READ_ONLY=true
GLOBAL_BUSINESS_WRITES_PAUSED=true
GLOBAL_UNVERIFIED_REGISTRATION_ENABLED=false
# Narrow outbound releases. Keep false on a new installation until the
# corresponding encrypted provider credentials and permissions are verified.
GLOBAL_HEALTH_REPORT_WORKER_ENABLED=false
GLOBAL_JUSHUITAN_OUTBOUND_ENABLED=false
