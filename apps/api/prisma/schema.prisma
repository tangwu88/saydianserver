  nameSnapshot                String
  specificationSnapshot       String?
  imageSnapshot               String?
  unitPriceCents              Int
  quantity                    Int
  totalCents                  Int
  couponDiscountCentsSnapshot Int?
  pointDiscountCentsSnapshot  Int?
  cashPaidCentsSnapshot       Int?
  order                       CommerceOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                     CommerceProduct         @relation(fields: [productId], references: [id])
  sku                         CommerceSku             @relation(fields: [skuId], references: [id])
  review                      CommerceReview?
  afterSaleItems              CommerceAfterSaleItem[]
  shipmentItems               CommerceShipmentItem[]

  @@index([orderId])
}

model CommerceShipment {
  id               String                 @id @default(uuid()) @db.Uuid
  orderId          String                 @db.Uuid
  logisticsCompany String
  logisticsCode    String?
  trackingNo       String
  traceJson        Json?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  order            CommerceOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items            CommerceShipmentItem[]

  @@unique([orderId, trackingNo])
}

model CommerceShipmentItem {
  id          String            @id @default(uuid()) @db.Uuid
  shipmentId  String            @db.Uuid
  orderItemId String            @db.Uuid
  quantity    Int
  shipment    CommerceShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   CommerceOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model CommerceAfterSale {
  requestKey             String?                 @unique
  requestedByAdminId     String?                 @db.Uuid
  reviewedByAdminId      String?                 @db.Uuid
  reviewedAt             DateTime?
  id                     String                  @id @default(uuid()) @db.Uuid
  legacyId               String?                 @unique
  sourceSystem           String                  @default("canonical")
  executionOwner         String                  @default("NEW_SYSTEM")
  version                Int                     @default(0)
  afterSaleNo            String                  @unique
  orderId                String                  @db.Uuid
  type                   AfterSaleType
  status                 AfterSaleStatus         @default(APPLIED)
  reason                 String
  description            String?
  evidenceImages         String[]
  requestedCents         Int
  pricingVersion         Int?
  pointReturnCents       Int?
  shippingRefundCents    Int?
  settledAt              DateTime?
  erpAfterSaleId         String?
  erpStatus              String?
  returnLogisticsCompany String?
  returnTrackingNo       String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  order                  CommerceOrder           @relation(fields: [orderId], references: [id])
  refunds                PaymentRefund[]
  items                  CommerceAfterSaleItem[]

  @@index([orderId, status])
}

model CommerceAfterSaleItem {
  id               String            @id @default(uuid()) @db.Uuid
  afterSaleId      String            @db.Uuid
  orderItemId      String            @db.Uuid
  quantity         Int
  amountCents      Int
  pointReturnCents Int?
  afterSale        CommerceAfterSale @relation(fields: [afterSaleId], references: [id], onDelete: Cascade)
  orderItem        CommerceOrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([afterSaleId, orderItemId])
}

model CommercePointAccount {
  userId       String   @id @db.Uuid
  balanceCents Int      @default(0)
  version      Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommercePointLedger {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  orderId        String?        @db.Uuid
  deltaCents     Int
  afterSaleId    String?        @db.Uuid
  refundId       String?        @db.Uuid
  type           String
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id])
  order          CommerceOrder? @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
}

model CommerceCoupon {
  id                     String                        @id @default(uuid()) @db.Uuid
  legacyId               String?                       @unique
  name                   String
  type                   CouponType
  status                 CouponStatus                  @default(DRAFT)
  value                  Int
  minimumSpendCents      Int                           @default(0)
  totalQuantity          Int?
  claimedQuantity        Int                           @default(0)
  employeeDistributable  Boolean                       @default(false)
  perEmployeeLimit       Int                           @default(0)
  employeeClaimBatchSize Int                           @default(1)
  employeeClaimUntil     DateTime?
  reservedGiftQuantity   Int                           @default(0)
  validFrom              DateTime
  validUntil             DateTime
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  claims                 CommerceCouponClaim[]
  employeeGrants         CommerceEmployeeCouponGrant[]
  gifts                  CommerceCouponGift[]

  @@index([status, validFrom, validUntil])
}

model CommerceCouponClaim {
  id               String              @id @default(uuid()) @db.Uuid
  couponId         String              @db.Uuid
  userId           String              @db.Uuid
  orderId          String?             @unique @db.Uuid
  claimedAt        DateTime            @default(now())
  usedAt           DateTime?
  sourceEmployeeId String?             @db.Uuid
  sourceGiftId     String?             @unique @db.Uuid
  coupon           CommerceCoupon      @relation(fields: [couponId], references: [id])
  user             User                @relation(fields: [userId], references: [id])
  order            CommerceOrder?      @relation(fields: [orderId], references: [id])
  sourceEmployee   CommerceEmployee?   @relation(fields: [sourceEmployeeId], references: [id])
  sourceGift       CommerceCouponGift? @relation(fields: [sourceGiftId], references: [id], onDelete: SetNull)

  @@unique([couponId, userId])
}

model CommerceEmployee {
  id              String                            @id @default(uuid()) @db.Uuid
  legacyId        String?                           @unique
  wecomUserId     String                            @unique
  name            String
  mobile          String?
  departmentNames String[]
  referralCode    String                            @unique
  avatarUrl       String?
  active          Boolean                           @default(true)
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt
  referredUsers   User[]                            @relation("LockedReferral")
  referredOrders  CommerceOrder[]                   @relation("OrderReferral")
  sourcedClaims   CommerceCouponClaim[]
  couponGrants    CommerceEmployeeCouponGrant[]
  couponGifts     CommerceCouponGift[]
  wallet          CommerceEmployeeWallet?
  payoutIdentity  CommerceEmployeePayoutIdentity?
  withdrawals     CommerceWithdrawal[]
  accruals        CommerceCommissionAccrual[]
  ledger          CommerceCommissionLedger[]
  legacyFinance   LegacyCommerceFinanceProjection[]
}

model CommerceEmployeeCouponGrant {
  id                String               @id @default(uuid()) @db.Uuid
  employeeId        String               @db.Uuid
  couponId          String               @db.Uuid
  allocatedQuantity Int                  @default(0)
  redeemedQuantity  Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  employee          CommerceEmployee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  coupon            CommerceCoupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  gifts             CommerceCouponGift[]

  @@unique([employeeId, couponId])
  @@index([couponId])
}

model CommerceCouponGift {
  id               String                      @id @default(uuid()) @db.Uuid
  tokenHash        String                      @unique
  code             String                      @unique
  status           CouponGiftStatus            @default(RESERVED)
  couponId         String                      @db.Uuid
  employeeId       String                      @db.Uuid
  grantId          String                      @db.Uuid
  expiresAt        DateTime
  redeemedByUserId String?                     @db.Uuid
  redeemedAt       DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  coupon           CommerceCoupon              @relation(fields: [couponId], references: [id], onDelete: Cascade)
