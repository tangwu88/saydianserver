generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETION_PENDING
  DELETED
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum HealthMetric {
  SLEEP
  STEPS
  DISTANCE
  CALORIES
  HEART_RATE
  BLOOD_OXYGEN
  BLOOD_PRESSURE
  BLOOD_GLUCOSE
  TEMPERATURE
  HRV
  ECG
  BODY_COMPOSITION
  BLOOD_COMPOSITION
}

enum DataQuality {
  UNKNOWN
  VALID
  SUSPECT
  INVALID
}

enum CareStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

enum NotificationType {
  CARE_INVITATION
  HEALTH_WARNING
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum IntegrationState {
  UNCONFIGURED
  CONFIGURED
  DISABLED
  ERROR
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AdminRole {
  SUPER_ADMIN
  APP_OPERATIONS
  COMMERCE_OPERATIONS
  FINANCE
  CONTENT_EDITOR
  CUSTOMER_SERVICE
  HEALTH_AUDITOR
  INTEGRATION_ADMIN
  API_DOC_EDITOR
  READ_ONLY
}

enum BusinessType {
  COMMERCE_ORDER
  HEALTH_REPORT
  HEALTH_MEMBERSHIP
}

enum PaymentChannel {
  OFFLINE_MANUAL
  WECHAT_MINI
  WECHAT_JSAPI
  WECHAT_H5
  WECHAT_NATIVE
  WECHAT_APP
  ALIPAY_WAP
  ALIPAY_PAGE
  ALIPAY_APP
  APPLE_IAP
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CLOSED
  REFUNDING
  PARTIAL_REFUNDED
  REFUNDED
}

enum RefundStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CLOSED
}

enum ReportStatus {
  AWAITING_PAYMENT
  QUEUED
  GENERATING
  READY
  FAILED
  REVOKED
}

enum ReportEntitlementType {
  SINGLE_REPORT
  MEMBERSHIP
}

enum CreditLedgerType {
  GRANT
  CONSUME
  EXPIRE
  REFUND_REVOKE
  ADMIN_ADJUSTMENT
}

enum MembershipStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  REFUNDED
  CANCELLED
}

enum ApiDocumentationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  OFF_SHELF
}

enum CommerceOrderStatus {
  PENDING_PAYMENT
  PAID
  WAITING_FULFILLMENT
  SHIPPED
  RECEIVED
  COMPLETED
  CANCELLED
  CLOSED
  AFTER_SALE
  REFUNDED
}

enum AfterSaleType {
  SHIPPING_ONLY
  REFUND_ONLY
  RETURN_REFUND
  EXCHANGE
}

enum AfterSaleStatus {
  APPLIED
  REVIEWING
  APPROVED
  REJECTED
  WAITING_RETURN
  RETURNED
  REFUNDING
  COMPLETED
  CANCELLED
}

enum CouponType {
  CASH
}

enum CouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum CouponGiftStatus {
  RESERVED
  CLAIMED
  EXPIRED
  REVOKED
}

enum CommerceJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum NotificationCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum AccountDeletionStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum MigrationRunStatus {
  PLANNED
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
}

model User {
  id                       String                            @id @default(uuid()) @db.Uuid
  compatibilityId          Int                               @unique @default(autoincrement())
  legacyMemberId           String?                           @unique
  mobile                   String?                           @unique
  mobileVerifiedAt         DateTime?
  email                    String?                           @unique
  emailVerifiedAt          DateTime?
  locale                   String?
  wechatUnionId            String?                           @unique
  wechatOpenId             String?                           @unique
  wechatAppOpenId          String?                           @unique
  passwordHash             String?
  status                   UserStatus                        @default(ACTIVE)
  nickname                 String
  avatarUrl                String?
  gender                   Gender                            @default(UNSPECIFIED)
  birthday                 DateTime?                         @db.Date
  heightCm                 Decimal?                          @db.Decimal(5, 2)
  weightKg                 Decimal?                          @db.Decimal(6, 2)
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  sessions                 UserSession[]
  consents                 ConsentRecord[]
  activityGoal             ActivityGoal?
  devices                  DeviceBinding[]
  healthRecords            HealthRecord[]
  warningRules             HealthWarningRule[]
  warningEvents            HealthWarningEvent[]
  careInvitationsSent      CareRelationship[]                @relation("CareInviter")
  careInvitationsRecv      CareRelationship[]                @relation("CareRecipient")
  notifications            Notification[]
  pushInstallations        PushInstallation[]
  notificationPreference   UserNotificationPreference?
  feedback                 Feedback[]
  aiConversations          AiConversation[]
  files                    FileObject[]
  legacyOrders             LegacyOrderProjection[]
  commerceIdentity         CommerceIdentityMap?
  idempotencyRecords       IdempotencyRecord[]
  deletionRequests         AccountDeletionRequest[]
  healthProfile            HealthProfile?
  healthReports            HealthReport[]
  reportCredits            ReportCreditLedger[]
  memberships              HealthMembership[]
  paymentIntents           PaymentIntent[]
  legacyFinance            LegacyMemberFinanceProjection[]
  legacyCommerceArchive    LegacyCommerceFinanceProjection[]
  commerceCart             CommerceCart?
  commerceAddresses        CommerceAddress[]
  commerceFavorites        CommerceFavorite[]
  commerceReviews          CommerceReview[]
  commerceOrders           CommerceOrder[]
  couponClaims             CommerceCouponClaim[]
  redeemedCouponGifts      CommerceCouponGift[]              @relation("CouponGiftRedeemer")
  referralEmployeeId       String?                           @db.Uuid
  referralEmployee         CommerceEmployee?                 @relation("LockedReferral", fields: [referralEmployeeId], references: [id], onDelete: SetNull)
  pointAccount             CommercePointAccount?
  pointLedger              CommercePointLedger[]
  legacySessions           LegacySessionCredential[]
  wechatOfficialIdentities WechatOfficialIdentity[]

  @@index([status, createdAt])
  @@index([referralEmployeeId])
}

model WechatOfficialIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  appId      String
  openId     String
  unionId    String?
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, openId])
  @@unique([userId, appId])
}

model CommerceOAuthState {
  stateHash     String    @id
  codeChallenge String
  appId         String
  returnTo      String
  referralCode  String?
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

model CommerceWechatBindTicket {
  tokenHash    String    @id
  appId        String
  openId       String
  unionId      String?
  returnTo     String
  referralCode String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  accessJti        String    @unique
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SmsCode {
  id         String    @id @default(uuid()) @db.Uuid
  mobile     String
  usage      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, usage, expiresAt])
}

// Only the separately deployed global service creates these challenges.
model GlobalVerificationChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  channel    String
  identifier String
  purpose    String
  locale     String    @default("en")
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  sentAt     DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, channel, createdAt])
}

model GlobalVerificationThrottle {
  key        String   @id
  reservedAt DateTime
}

model GlobalLegalDocument {
  id           String    @id @default(uuid()) @db.Uuid
  documentType String
  version      String
  locale       String    @default("en")
  title        String
  contentHtml  String
  reviewed     Boolean   @default(false)
  active       Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([documentType, version, locale])
  @@index([locale, active, reviewed])
}

model ConsentRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  documentType  String
  version       String
  acceptedAt    DateTime  @default(now())
  withdrawnAt   DateTime?
  source        String
  ipHash        String?
  userAgentHash String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId, acceptedAt])
}

model ActivityGoal {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  steps          Int?
  distanceMeters Int?
  caloriesKcal   Int?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceBinding {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  hardwareKey   String         @unique
  vendor        String
  model         String
  displayName   String
  firmware      String?
  capabilities  Json
  syncCursor    String?
  boundAt       DateTime       @default(now())
  unboundAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthRecords HealthRecord[]

  @@index([userId, unboundAt])
}

model HealthRecord {
  id                      String         @id @default(uuid()) @db.Uuid
  userId                  String         @db.Uuid
  clientRecordId          String
  metric                  HealthMetric
  observedAt              DateTime
  timezoneOffsetMinutes   Int
  values                  Json
  unit                    String?
  quality                 DataQuality    @default(UNKNOWN)
  sourcePlatform          String
  sourceModel             String?
  sourceFirmware          String?
  sourceOrigin            String?
  sourceMeasurementSource String?
  sourceRawVersion        Int?
  deviceBindingId         String?        @db.Uuid
  // Scoped device fingerprint also preserves identity before a device is bound.
  sourceDeviceKey         String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceBinding           DeviceBinding? @relation(fields: [deviceBindingId], references: [id], onDelete: SetNull)
  ecgArtifact             EcgArtifact?

  @@unique([userId, clientRecordId])
  @@index([userId, metric, observedAt])
  @@index([deviceBindingId, observedAt])
}

model EcgArtifact {
  id             String       @id @default(uuid()) @db.Uuid
  healthRecordId String       @unique @db.Uuid
  objectKey      String       @unique
  sha256         String
  sampleRateHz   Int
  sampleCount    Int
  byteSize       Int
  compression    String
  createdAt      DateTime     @default(now())
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
}

model HealthWarningRule {
  id                     String       @id @default(uuid()) @db.Uuid
  userId                 String       @db.Uuid
  metric                 HealthMetric
  enabled                Boolean      @default(true)
  lowThreshold           Decimal?     @db.Decimal(12, 4)
  highThreshold          Decimal?     @db.Decimal(12, 4)
  secondaryHighThreshold Decimal?     @db.Decimal(12, 4)
  shareWithCare          Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric])
}

model HealthWarningEvent {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  eventId       String       @unique
  metric        HealthMetric
  observedAt    DateTime
  ruleSnapshot  Json
  valueSnapshot Json
  source        String
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
}

model CareRelationship {
  id              String            @id @default(uuid()) @db.Uuid
  compatibilityId Int               @unique @default(autoincrement())
  invitationId    String            @unique
  inviterId       String            @db.Uuid
  recipientId     String            @db.Uuid
  status          CareStatus        @default(PENDING)
  expiresAt       DateTime?
  respondedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  inviter         User              @relation("CareInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  recipient       User              @relation("CareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  permissions     CarePermission[]
  accessAudits    CareAccessAudit[]

  @@unique([inviterId, recipientId])
  @@index([recipientId, status])
  @@index([inviterId, status])
}

model CarePermission {
  id             String           @id @default(uuid()) @db.Uuid
  relationshipId String           @db.Uuid
  metric         HealthMetric
  enabled        Boolean          @default(true)
  expiresAt      DateTime?
  updatedAt      DateTime         @updatedAt
  relationship   CareRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, metric])
}

model CareAccessAudit {
  id             String           @id @default(uuid()) @db.Uuid
  relationshipId String           @db.Uuid
  viewerUserId   String           @db.Uuid
  subjectUserId  String           @db.Uuid
  metric         HealthMetric
  result         String
  requestId      String
  createdAt      DateTime         @default(now())
  relationship   CareRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([viewerUserId, createdAt])
  @@index([subjectUserId, createdAt])
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  compatibilityId Int              @unique @default(autoincrement())
  userId          String           @db.Uuid
  eventId         String
  type            NotificationType
  title           String
  body            String
  deepLink        String?
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, readAt, createdAt])
}

model PushInstallation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  installationId String   @unique
  provider       String
  registrationId String
  platform       String
  appVersion     String
  buildNumber    String
  locale         String?
  enabled        Boolean  @default(true)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model UserNotificationPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  transactionalEnabled Boolean  @default(true)
  marketingEnabled     Boolean  @default(false)
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @unique
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lockedAt      DateTime?
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
}

model ArticleCategory {
  id        String            @id @default(uuid()) @db.Uuid
  legacyId  String?           @unique
  name      String
  locale    String?
  parentId  String?           @db.Uuid
  sort      Int               @default(0)
  enabled   Boolean           @default(true)
  parent    ArticleCategory?  @relation("ArticleCategoryTree", fields: [parentId], references: [id])
  children  ArticleCategory[] @relation("ArticleCategoryTree")
  articles  Article[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Article {
  id          String           @id @default(uuid()) @db.Uuid
  legacyId    String?          @unique
  categoryId  String?          @db.Uuid
  title       String
  locale      String?
  summary     String?
  coverUrl    String?
  contentHtml String
  status      String           @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model AiConversation {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  clientSessionId String?
  title           String?
  locale          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           String
  content        String
  provider       String?
  providerRef    String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Feedback {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String?        @db.Uuid
  category     String
  content      String
  contact      String?
  attachments  Json?
  status       FeedbackStatus @default(OPEN)
  assignedTo   String?
  replyContent String?
  repliedAt    DateTime?
  repliedBy    String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model LegalDocument {
  id           String    @id @default(uuid()) @db.Uuid
  documentType String
  version      String
  title        String
  contentHtml  String
  publishedAt  DateTime?
  active       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([documentType, version])
  @@index([documentType, active])
}

model FileObject {
  id           String   @id @default(uuid()) @db.Uuid
  ownerUserId  String?  @db.Uuid
  objectKey    String   @unique
  originalName String
  contentType  String
  byteSize     Int
  sha256       String
  purpose      String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  owner        User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
}

model LegacyIdMap {
  id              String    @id @default(uuid()) @db.Uuid
  sourceSystem    String    @default("legacy_app")
  entityType      String
  legacyId        String
  targetId        String
  sourceTable     String
  migratedAt      DateTime  @default(now())
  runId           String?   @db.Uuid
  sourceHash      String?
  sourceUpdatedAt DateTime?
  sourceDeletedAt DateTime?

  @@unique([sourceSystem, entityType, legacyId])
  @@index([targetId])
}

// Only imported, independently verified source sessions are eligible. Raw tokens
// are never stored; the bridge is disabled unless its explicit deadline is set.
model LegacySessionCredential {
  id                   String    @id @default(uuid()) @db.Uuid
  sourceSystem         String
  tokenDigest          String
  userId               String    @db.Uuid
  sourceSessionId      String
  sourceVerifiedAt     DateTime
  verificationEvidence String
  expiresAt            DateTime
  revokedAt            DateTime?
  sessionId            String?   @unique @db.Uuid
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, tokenDigest])
  @@index([userId, expiresAt])
}

model CompatibilityId {
  id         Int      @id @default(autoincrement())
  entityType String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([entityType, externalId])
}

model LegacyOrderProjection {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  legacyOrderId   String
  orderNo         String
  status          String
  payableCents    Int
  currency        String   @default("CNY")
  snapshot        Json
  legacyCreatedAt DateTime
  migratedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, legacyOrderId])
  @@index([userId, legacyCreatedAt])
}

model CommerceIdentityMap {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  mallUserId String   @unique
  linkedBy   String
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntegrationConfig {
  id            String             @id @default(uuid()) @db.Uuid
  key           String             @unique
  state         IntegrationState   @default(UNCONFIGURED)
  publicConfig  Json
  secretRef     String?
  lastCheckedAt DateTime?
  lastError     String?
  updatedAt     DateTime           @updatedAt
  secret        IntegrationSecret?
}

model IntegrationSecret {
  integrationKey String            @id
  ciphertext     String
  iv             String
  authTag        String
  keyVersion     Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  integration    IntegrationConfig @relation(fields: [integrationKey], references: [key], onDelete: Cascade)
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  username     String         @unique
  displayName  String
  passwordHash String
  role         AdminRole
  roles        AdminRole[]    @default([])
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorType  String
  actorId    String
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  requestId  String?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  scope        String
  key          String
  requestHash  String
  responseCode Int
  responseBody Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

model AccountDeletionRequest {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  status        AccountDeletionStatus @default(REQUESTED)
  requestedAt   DateTime              @default(now())
  executeAfter  DateTime
  completedAt   DateTime?
  failureReason String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, executeAfter])
}

model AppSetting {
  key       String   @id
  value     Json
  public    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model MigrationRun {
  id           String                @id @default(uuid()) @db.Uuid
  sourceLabel  String
  sourceDigest String?
  status       MigrationRunStatus    @default(PLANNED)
  startedAt    DateTime?
  completedAt  DateTime?
  report       Json?
  createdAt    DateTime              @default(now())
  conflicts    MigrationConflict[]
  checkpoints  MigrationCheckpoint[]
}

model MigrationCheckpoint {
  id           String       @id @default(uuid()) @db.Uuid
  runId        String       @db.Uuid
  sourceSystem String
  sourceTable  String
  cursor       String
  rowCount     Int          @default(0)
  updatedAt    DateTime     @updatedAt
  run          MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sourceTable])
}

model MigrationConflict {
  id         String       @id @default(uuid()) @db.Uuid
  runId      String       @db.Uuid
  entityType String
  legacyId   String
  reason     String
  snapshot   Json
  resolution String?
  resolvedAt DateTime?
  run        MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, entityType, legacyId])
}

// Health profile and paid wellness reports. Raw measurements remain in
// HealthRecord; these models store consent, evidence indexes and generated views.
model HealthProfile {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @unique @db.Uuid
  timezone                 String    @default("Asia/Shanghai")
  analysisConsentVersion   String?
  analysisConsentedAt      DateTime?
  analysisConsentWithdrawn DateTime?
  lastAnalyzedAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthReportOffer {
  id             String                @id @default(uuid()) @db.Uuid
  code           String                @unique
  offerKey       String
  title          String
  description    String
  entitlement    ReportEntitlementType
  priceCents     Int
  currency       String                @default("CNY")
  creditCount    Int                   @default(1)
  durationDays   Int?
  platforms      String[]
  appleProductId String?               @unique
  version        Int                   @default(1)
  active         Boolean               @default(false)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  memberships    HealthMembership[]

  @@unique([offerKey, version])
  @@index([active, entitlement])
}

model HealthReport {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  status             ReportStatus         @default(AWAITING_PAYMENT)
  windowStart        DateTime
  windowEnd          DateTime
  distinctDays       Int
  validRecordCount   Int
  metricSummary      Json
  evidenceIndex      Json
  inputDigest        String
  freePreview        Json
  fullContent        Json?
  templateVersion    String
  aiGenerated        Boolean              @default(false)
  aiProvider         String?
  aiModel            String?
  aiLabelVersion     String?
  adminConsentBypass Boolean              @default(false)
  generationAttempts Int                  @default(0)
  failureReason      String?
  generatedAt        DateTime?
  revokedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentIntents     PaymentIntent[]      @relation("ReportPayments")
  creditEntries      ReportCreditLedger[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model HealthMembership {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @db.Uuid
  offerId          String               @db.Uuid
  status           MembershipStatus     @default(PENDING_PAYMENT)
  startsAt         DateTime?
  expiresAt        DateTime?
  creditsGranted   Int
  remainingCredits Int
  refundedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer            HealthReportOffer    @relation(fields: [offerId], references: [id])
  paymentIntents   PaymentIntent[]      @relation("MembershipPayments")
  creditEntries    ReportCreditLedger[]

  @@index([userId, status, expiresAt])
}

model ReportCreditLedger {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  type           CreditLedgerType
  delta          Int
  balanceAfter   Int
  sourceType     String
  sourceId       String
  healthReportId String?           @db.Uuid
  membershipId   String?           @db.Uuid
  availableAt    DateTime          @default(now())
  expiresAt      DateTime?
  idempotencyKey String            @unique
  note           String?
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthReport   HealthReport?     @relation(fields: [healthReportId], references: [id], onDelete: SetNull)
  membership     HealthMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
}

// A single payment state machine is shared by physical orders and digital
// health entitlements. Provider callbacks are deduplicated by ProviderEvent.
model PaymentIntent {
  id                         String            @id @default(uuid()) @db.Uuid
  paymentNo                  String            @unique
  sourceSystem               String            @default("canonical")
  executionOwner             String            @default("NEW_SYSTEM")
  userId                     String            @db.Uuid
  businessType               BusinessType
  businessId                 String
  commerceOrderId            String?           @db.Uuid
  healthReportId             String?           @db.Uuid
  healthMembershipId         String?           @db.Uuid
  channel                    PaymentChannel
  status                     PaymentStatus     @default(CREATED)
  amountCents                Int
  currency                   String            @default("CNY")
  description                String
  idempotencyKey             String            @unique
  providerTransactionId      String?           @unique
  // New payments bind to the exact credential set used at creation. Null is
  // reserved for historical rows and deliberately resolves to the legacy H5
  // credential set so existing queries, closes and refunds keep working.
  integrationKey             String?
  providerMerchantId         String?
  providerAppId              String?
  appleOriginalTransactionId String?
  providerPayload            Json?
  paidAt                     DateTime?
  closedAt                   DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  user                       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  commerceOrder              CommerceOrder?    @relation("OrderPayments", fields: [commerceOrderId], references: [id], onDelete: SetNull)
  healthReport               HealthReport?     @relation("ReportPayments", fields: [healthReportId], references: [id], onDelete: SetNull)
  healthMembership           HealthMembership? @relation("MembershipPayments", fields: [healthMembershipId], references: [id], onDelete: SetNull)
  refunds                    PaymentRefund[]

  @@index([userId, businessType, createdAt])
  @@index([status, createdAt])
  @@index([integrationKey, status])
  @@index([appleOriginalTransactionId])
}

model PaymentRefund {
  id                     String             @id @default(uuid()) @db.Uuid
  refundNo               String             @unique
  sourceSystem           String             @default("canonical")
  executionOwner         String             @default("NEW_SYSTEM")
  paymentIntentId        String             @db.Uuid
  afterSaleId            String?            @db.Uuid
  status                 RefundStatus       @default(CREATED)
  amountCents            Int
  merchandiseRefundCents Int?
  shippingRefundCents    Int?
  reason                 String
  idempotencyKey         String             @unique
  providerRefundId       String?            @unique
  providerPayload        Json?
  completedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  paymentIntent          PaymentIntent      @relation(fields: [paymentIntentId], references: [id])
  afterSale              CommerceAfterSale? @relation(fields: [afterSaleId], references: [id], onDelete: SetNull)

  @@index([paymentIntentId, status])
}

model ProviderEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  eventKey        String
  eventType       String
  headers         Json?
  payload         Json
  sourceSystem    String    @default("canonical")
  verifiedAt      DateTime?
  processingState String    @default("RECEIVED")
  processedAt     DateTime?
  processError    String?
  createdAt       DateTime  @default(now())

  @@unique([provider, eventKey])
  @@index([provider, eventType, createdAt])
}

// Commerce models migrated from saidian-mall@09963c4. All member relations use
// the canonical core User UUID; there is no runtime identity-network lookup.
model CommerceCart {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @db.Uuid
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CommerceCartItem[]
}

model CommerceCartItem {
  id        String       @id @default(uuid()) @db.Uuid
  cartId    String       @db.Uuid
  skuId     String       @db.Uuid
  quantity  Int
  selected  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  cart      CommerceCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku       CommerceSku  @relation(fields: [skuId], references: [id])

  @@unique([cartId, skuId])
  @@index([skuId])
}

model CommerceAddress {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  legacyId     String?
  name         String
  mobile       String
  countryCode  String?
  province     String
  provinceCode String?
  city         String
  cityCode     String?
  district     String
  districtCode String?
  detail       String
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, legacyId])
  @@index([userId, isDefault])
}

model CommerceCategory {
  id            String             @id @default(uuid()) @db.Uuid
  legacyId      String?            @unique
  erpCategoryId String?            @unique
  name          String
  iconUrl       String?
  sort          Int                @default(0)
  enabled       Boolean            @default(true)
  parentId      String?            @db.Uuid
  parent        CommerceCategory?  @relation("CommerceCategoryTree", fields: [parentId], references: [id])
  children      CommerceCategory[] @relation("CommerceCategoryTree")
  products      CommerceProduct[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([parentId, enabled, sort])
}

model CommerceProduct {
  id            String              @id @default(uuid()) @db.Uuid
  legacyId      String?             @unique
  erpItemId     String              @unique
  source        String              @default("ERP")
  localArchived Boolean             @default(false)
  name          String
  displayName   String?
  subtitle      String?
  brand         String?
  coverImage    String?
  gallery       String[]
  detailHtml    String?
  tags          String[]
  categoryId    String?             @db.Uuid
  status        ProductStatus       @default(DRAFT)
  featured      Boolean             @default(false)
  sort          Int                 @default(0)
  sales         Int                 @default(0)
  erpModifiedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  category      CommerceCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  skus          CommerceSku[]
  favorites     CommerceFavorite[]
  reviews       CommerceReview[]
  orderItems    CommerceOrderItem[]

  @@index([status, sort])
  @@index([localArchived, status, sort])
  @@index([categoryId])
}

model CommerceSku {
  id               String              @id @default(uuid()) @db.Uuid
  legacyId         String?             @unique
  erpSkuId         String              @unique
  erpItemId        String
  productId        String              @db.Uuid
  specification    String?
  barcode          String?
  image            String?
  salePriceCents   Int
  marketPriceCents Int?
  costPriceCents   Int?
  stock            Int                 @default(0)
  weightGrams      Int?
  enabled          Boolean             @default(true)
  erpModifiedAt    DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  product          CommerceProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       CommerceOrderItem[]
  cartItems        CommerceCartItem[]

  @@index([productId, enabled])
}

model CommerceFavorite {
  userId    String          @db.Uuid
  productId String          @db.Uuid
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model CommerceReview {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  productId   String            @db.Uuid
  orderItemId String            @unique @db.Uuid
  rating      Int
  content     String
  images      String[]
  published   Boolean           @default(true)
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id])
  product     CommerceProduct   @relation(fields: [productId], references: [id])
  orderItem   CommerceOrderItem @relation(fields: [orderItemId], references: [id])

  @@index([productId, published])
}

model CommerceOrder {
  id                   String                     @id @default(uuid()) @db.Uuid
  legacyId             String?                    @unique
  sourceSystem         String                     @default("canonical")
  executionOwner       String                     @default("NEW_SYSTEM")
  version              Int                        @default(0)
  orderNo              String                     @unique
  userId               String                     @db.Uuid
  status               CommerceOrderStatus        @default(PENDING_PAYMENT)
  referralEmployeeId   String?                    @db.Uuid
  referralCodeSnapshot String?
  subtotalCents        Int
  discountCents        Int                        @default(0)
  pointDiscountCents   Int                        @default(0)
  shippingCents        Int                        @default(0)
  payableCents         Int
  currency             String                     @default("CNY")
  recipientName        String
  recipientMobile      String
  countryCode          String?
  postalCode           String?
  province             String
  city                 String
  district             String
  addressDetail        String
  buyerRemark          String?
  adminRemark          String?
  invoiceJson          Json?
  erpShopId            String?
  erpOrderId           String?
  erpStatus            String?
  idempotencyKey       String                     @unique
  pricingVersion       Int?
  pricingVerifiedAt    DateTime?
  requestHash          String?
  paidAt               DateTime?
  shippedAt            DateTime?
  receivedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  user                 User                       @relation(fields: [userId], references: [id])
  referralEmployee     CommerceEmployee?          @relation("OrderReferral", fields: [referralEmployeeId], references: [id])
  items                CommerceOrderItem[]
  paymentIntents       PaymentIntent[]            @relation("OrderPayments")
  shipments            CommerceShipment[]
  afterSales           CommerceAfterSale[]
  couponClaim          CommerceCouponClaim?
  commissionAccrual    CommerceCommissionAccrual?
  commissionLedger     CommerceCommissionLedger[]
  pointLedger          CommercePointLedger[]

  @@index([userId, status, createdAt])
  @@index([referralEmployeeId, paidAt])
}

model CommerceOrderItem {
  id                          String                  @id @default(uuid()) @db.Uuid
  orderId                     String                  @db.Uuid
  productId                   String                  @db.Uuid
  skuId                       String                  @db.Uuid
