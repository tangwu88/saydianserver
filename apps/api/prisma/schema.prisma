  grant            CommerceEmployeeCouponGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  redeemedByUser   User?                       @relation("CouponGiftRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  claim            CommerceCouponClaim?

  @@index([employeeId, couponId, status])
  @@index([status, expiresAt])
}

model CommerceCommissionPlan {
  id                      String    @id @default("default")
  enabled                 Boolean   @default(false)
  rateBps                 Int       @default(0)
  settlementDays          Int       @default(7)
  enabledAt               DateTime?
  withdrawalEnabled       Boolean   @default(false)
  minimumWithdrawCents    Int?
  dailyWithdrawLimitCents Int?
  reviewRequired          Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model CommerceCommissionAccrual {
  id                     String           @id @default(uuid()) @db.Uuid
  employeeId             String           @db.Uuid
  orderId                String           @unique @db.Uuid
  baseCents              Int
  refundedBaseCents      Int              @default(0)
  rateBps                Int
  settlementDaysSnapshot Int?
  grossBonusCents        Int
  reversedBonusCents     Int              @default(0)
  status                 String           @default("FROZEN")
  availableAt            DateTime?
  settledAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  employee               CommerceEmployee @relation(fields: [employeeId], references: [id])
  order                  CommerceOrder    @relation(fields: [orderId], references: [id])

  @@index([employeeId, status, availableAt])
}

model CommerceEmployeeWallet {
  employeeId       String           @id @db.Uuid
  frozenCents      Int              @default(0)
  availableCents   Int              @default(0)
  withdrawingCents Int              @default(0)
  debtCents        Int              @default(0)
  totalPaidCents   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  employee         CommerceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model CommerceCommissionLedger {
  id                    String              @id @default(uuid()) @db.Uuid
  employeeId            String              @db.Uuid
  orderId               String?             @db.Uuid
  refundId              String?             @db.Uuid
  type                  String
  frozenDeltaCents      Int                 @default(0)
  availableDeltaCents   Int                 @default(0)
  debtDeltaCents        Int                 @default(0)
  withdrawingDeltaCents Int                 @default(0)
  paidDeltaCents        Int                 @default(0)
  withdrawalId          String?             @db.Uuid
  idempotencyKey        String              @unique
  memo                  String?
  createdAt             DateTime            @default(now())
  employee              CommerceEmployee    @relation(fields: [employeeId], references: [id])
  order                 CommerceOrder?      @relation(fields: [orderId], references: [id])
  withdrawal            CommerceWithdrawal? @relation(fields: [withdrawalId], references: [id])

  @@index([employeeId, createdAt])
  @@index([orderId, createdAt])
}

model CommerceEmployeePayoutIdentity {
  employeeId           String           @id @db.Uuid
  openId               String           @unique
  authorizationId      String?
  outAuthorizationNo   String?
  authorizationStatus  String           @default("NONE")
  authorizedAt         DateTime?
  revokedAt            DateTime?
  verifiedAt           DateTime?
  verificationEvidence String?
  employee             CommerceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model CommerceWithdrawal {
  id                     String                     @id @default(uuid()) @db.Uuid
  legacyId               String?                    @unique
  withdrawalNo           String                     @unique @default(cuid())
  sourceSystem           String                     @default("canonical")
  executionOwner         String                     @default("NEW_SYSTEM")
  employeeId             String                     @db.Uuid
  amountCents            Int
  status                 String                     @default("SUBMITTED")
  providerTransferId     String?                    @unique
  idempotencyKey         String                     @unique
  requestHash            String
  version                Int                        @default(0)
  payoutIdentitySnapshot Json?
  providerPayload        Json?
  failureReason          String?
  packageInfo            String?
  verificationEvidence   String?
  reviewedById           String?                    @db.Uuid
  reviewNote             String?
  receiptReference       String?
  reviewedAt             DateTime?
  paidAt                 DateTime?
  completedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  employee               CommerceEmployee           @relation(fields: [employeeId], references: [id])
  ledger                 CommerceCommissionLedger[]

  @@index([employeeId, status, createdAt])
}

model LegacyMemberFinanceProjection {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  sourceType String
  legacyId   String
  snapshot   Json
  occurredAt DateTime?
  migratedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, legacyId])
  @@index([userId, occurredAt])
}

// Immutable history for discontinued mall finance features such as employee
// withdrawals. It is never consumed by payment, wallet or payout workflows.
model LegacyCommerceFinanceProjection {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String?           @db.Uuid
  employeeId String?           @db.Uuid
  sourceType String
  legacyId   String
  snapshot   Json
  occurredAt DateTime?
  migratedAt DateTime          @default(now())
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  employee   CommerceEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([sourceType, legacyId])
  @@index([userId, occurredAt])
  @@index([employeeId, occurredAt])
}

model CommerceBusinessConfig {
  key       String   @id
  label     String
  value     Json?
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model CommerceBanner {
  id        String   @id @default(uuid()) @db.Uuid
  legacyId  String?  @unique
  title     String
  imageUrl  String
  targetUrl String?
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommerceIntegrationJob {
  id             String            @id @default(uuid()) @db.Uuid
  type           String
  status         CommerceJobStatus @default(PENDING)
  aggregateType  String?
  aggregateId    String?
  idempotencyKey String            @unique
  payload        Json
  attempt        Int               @default(0)
  maxAttempts    Int               @default(8)
  nextRunAt      DateTime          @default(now())
  lockedAt       DateTime?
  finishedAt     DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, nextRunAt])
}

model NotificationCampaign {
  id            String                         @id @default(uuid()) @db.Uuid
  name          String
  templateKey   String?
  type          NotificationType
  title         String
  body          String
  deepLink      String?
  audience      Json
  transactional Boolean                        @default(false)
  scheduledAt   DateTime?
  status        NotificationCampaignStatus     @default(DRAFT)
  createdById   String                         @db.Uuid
  approvedById  String?                        @db.Uuid
  sentCount     Int                            @default(0)
  failedCount   Int                            @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  deliveries    NotificationCampaignDelivery[]

  @@index([status, scheduledAt])
}

model NotificationCampaignDelivery {
  id            String               @id @default(uuid()) @db.Uuid
  campaignId    String               @db.Uuid
  userId        String               @db.Uuid
  eventId       String               @unique
  status        OutboxStatus         @default(PENDING)
  failureReason String?
  deliveredAt   DateTime?
  createdAt     DateTime             @default(now())
  campaign      NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId, status])
}

model ApiDocumentationAnnotation {
  id                String   @id @default(uuid()) @db.Uuid
  routeKey          String   @unique
  signatureHash     String
  title             String
  summary           String
  businessExample   Json?
  errorGuidance     Json?
  tags              String[]
  deprecated        Boolean  @default(false)
  deprecationNote   String?
  draftRevision     Int      @default(1)
  publishedRevision Int?
  createdById       String   @db.Uuid
  updatedById       String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([signatureHash])
}

model ApiDocumentationRelease {
  id           String                 @id @default(uuid()) @db.Uuid
  version      Int                    @unique @default(autoincrement())
  status       ApiDocumentationStatus @default(DRAFT)
  routeDigest  String
  snapshot     Json
  changeNote   String
  createdById  String                 @db.Uuid
  reviewedById String?                @db.Uuid
  publishedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status, createdAt])
}
