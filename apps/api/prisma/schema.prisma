generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETION_PENDING
  DELETED
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum HealthMetric {
  SLEEP
  STEPS
  DISTANCE
  CALORIES
  HEART_RATE
  BLOOD_OXYGEN
  BLOOD_PRESSURE
  BLOOD_GLUCOSE
  TEMPERATURE
  HRV
  ECG
  BODY_COMPOSITION
  BLOOD_COMPOSITION
}

enum DataQuality {
  UNKNOWN
  VALID
  SUSPECT
  INVALID
}

enum CareStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

enum NotificationType {
  CARE_INVITATION
  HEALTH_WARNING
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum IntegrationState {
  UNCONFIGURED
  CONFIGURED
  DISABLED
  ERROR
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AdminRole {
  SUPER_ADMIN
  APP_OPERATIONS
  CONTENT_EDITOR
  CUSTOMER_SERVICE
  HEALTH_AUDITOR
  READ_ONLY
}

enum AccountDeletionStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum MigrationRunStatus {
  PLANNED
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  compatibilityId     Int                      @unique @default(autoincrement())
  legacyMemberId      String?                  @unique
  mobile              String?                  @unique
  wechatUnionId       String?                  @unique
  passwordHash        String?
  status              UserStatus               @default(ACTIVE)
  nickname            String
  avatarUrl           String?
  gender              Gender                   @default(UNSPECIFIED)
  birthday            DateTime?                @db.Date
  heightCm            Decimal?                 @db.Decimal(5, 2)
  weightKg            Decimal?                 @db.Decimal(6, 2)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sessions            UserSession[]
  consents            ConsentRecord[]
  activityGoal        ActivityGoal?
  devices             DeviceBinding[]
  healthRecords       HealthRecord[]
  warningRules        HealthWarningRule[]
  warningEvents       HealthWarningEvent[]
  careInvitationsSent CareRelationship[]       @relation("CareInviter")
  careInvitationsRecv CareRelationship[]       @relation("CareRecipient")
  notifications       Notification[]
  pushInstallations   PushInstallation[]
  feedback            Feedback[]
  aiConversations     AiConversation[]
  files               FileObject[]
  legacyOrders        LegacyOrderProjection[]
  commerceIdentity    CommerceIdentityMap?
  idempotencyRecords  IdempotencyRecord[]
  deletionRequests    AccountDeletionRequest[]

  @@index([status, createdAt])
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  accessJti        String    @unique
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SmsCode {
  id         String    @id @default(uuid()) @db.Uuid
  mobile     String
  usage      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, usage, expiresAt])
}

model ConsentRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  documentType  String
  version       String
  acceptedAt    DateTime  @default(now())
  withdrawnAt   DateTime?
  source        String
  ipHash        String?
  userAgentHash String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId, acceptedAt])
}

model ActivityGoal {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  steps          Int?
  distanceMeters Int?
  caloriesKcal   Int?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceBinding {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  hardwareKey   String         @unique
  vendor        String
  model         String
  displayName   String
  firmware      String?
  capabilities  Json
  syncCursor    String?
  boundAt       DateTime       @default(now())
  unboundAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthRecords HealthRecord[]

  @@index([userId, unboundAt])
}

model HealthRecord {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @db.Uuid
  clientRecordId        String
  metric                HealthMetric
  observedAt            DateTime
  timezoneOffsetMinutes Int
  values                Json
  unit                  String?
  quality               DataQuality    @default(UNKNOWN)
  sourcePlatform        String
  sourceModel           String?
  sourceFirmware        String?
  deviceBindingId       String?        @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceBinding         DeviceBinding? @relation(fields: [deviceBindingId], references: [id], onDelete: SetNull)
  ecgArtifact           EcgArtifact?

  @@unique([userId, clientRecordId])
  @@index([userId, metric, observedAt])
  @@index([deviceBindingId, observedAt])
}

model EcgArtifact {
  id             String       @id @default(uuid()) @db.Uuid
  healthRecordId String       @unique @db.Uuid
  objectKey      String       @unique
  sha256         String
  sampleRateHz   Int
  sampleCount    Int
  byteSize       Int
  compression    String
  createdAt      DateTime     @default(now())
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
}

model HealthWarningRule {
  id                     String       @id @default(uuid()) @db.Uuid
  userId                 String       @db.Uuid
  metric                 HealthMetric
  enabled                Boolean      @default(true)
  lowThreshold           Decimal?     @db.Decimal(12, 4)
  highThreshold          Decimal?     @db.Decimal(12, 4)
  secondaryHighThreshold Decimal?     @db.Decimal(12, 4)
  shareWithCare          Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric])
}

model HealthWarningEvent {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  eventId       String       @unique
  metric        HealthMetric
  observedAt    DateTime
  ruleSnapshot  Json
  valueSnapshot Json
  source        String
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
}

model CareRelationship {
  id              String            @id @default(uuid()) @db.Uuid
  compatibilityId Int               @unique @default(autoincrement())
  invitationId    String            @unique
  inviterId       String            @db.Uuid
  recipientId     String            @db.Uuid
  status          CareStatus        @default(PENDING)
  expiresAt       DateTime?
  respondedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  inviter         User              @relation("CareInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  recipient       User              @relation("CareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  permissions     CarePermission[]
  accessAudits    CareAccessAudit[]

  @@unique([inviterId, recipientId])
  @@index([recipientId, status])
  @@index([inviterId, status])
}

model CarePermission {
  id             String           @id @default(uuid()) @db.Uuid
  relationshipId String           @db.Uuid
  metric         HealthMetric
  enabled        Boolean          @default(true)
  expiresAt      DateTime?
  updatedAt      DateTime         @updatedAt
  relationship   CareRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, metric])
}

model CareAccessAudit {
  id             String           @id @default(uuid()) @db.Uuid
  relationshipId String           @db.Uuid
  viewerUserId   String           @db.Uuid
  subjectUserId  String           @db.Uuid
  metric         HealthMetric
  result         String
  requestId      String
  createdAt      DateTime         @default(now())
  relationship   CareRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([viewerUserId, createdAt])
  @@index([subjectUserId, createdAt])
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  compatibilityId Int              @unique @default(autoincrement())
  userId          String           @db.Uuid
  eventId         String
  type            NotificationType
  title           String
  body            String
  deepLink        String?
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, readAt, createdAt])
}

model PushInstallation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  installationId String   @unique
  provider       String
  registrationId String
  platform       String
  appVersion     String
  buildNumber    String
  locale         String?
  enabled        Boolean  @default(true)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @unique
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lockedAt      DateTime?
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
}

model ArticleCategory {
  id        String            @id @default(uuid()) @db.Uuid
  legacyId  String?           @unique
  name      String
  parentId  String?           @db.Uuid
  sort      Int               @default(0)
  enabled   Boolean           @default(true)
  parent    ArticleCategory?  @relation("ArticleCategoryTree", fields: [parentId], references: [id])
  children  ArticleCategory[] @relation("ArticleCategoryTree")
  articles  Article[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Article {
  id          String           @id @default(uuid()) @db.Uuid
  legacyId    String?          @unique
  categoryId  String?          @db.Uuid
  title       String
  summary     String?
  coverUrl    String?
  contentHtml String
  status      String           @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model AiConversation {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  clientSessionId String?
  title           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           String
  content        String
  provider       String?
  providerRef    String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Feedback {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String?        @db.Uuid
  category    String
  content     String
  contact     String?
  attachments Json?
  status      FeedbackStatus @default(OPEN)
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model LegalDocument {
  id           String    @id @default(uuid()) @db.Uuid
  documentType String
  version      String
  title        String
  contentHtml  String
  publishedAt  DateTime?
  active       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([documentType, version])
  @@index([documentType, active])
}

model FileObject {
  id           String   @id @default(uuid()) @db.Uuid
  ownerUserId  String?  @db.Uuid
  objectKey    String   @unique
  originalName String
  contentType  String
  byteSize     Int
  sha256       String
  purpose      String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  owner        User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
}

model LegacyIdMap {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  legacyId    String
  targetId    String
  sourceTable String
  migratedAt  DateTime @default(now())
  runId       String?  @db.Uuid

  @@unique([entityType, legacyId])
  @@index([targetId])
}

model CompatibilityId {
  id         Int      @id @default(autoincrement())
  entityType String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([entityType, externalId])
}

model LegacyOrderProjection {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  legacyOrderId   String
  orderNo         String
  status          String
  payableCents    Int
  currency        String   @default("CNY")
  snapshot        Json
  legacyCreatedAt DateTime
  migratedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, legacyOrderId])
  @@index([userId, legacyCreatedAt])
}

model CommerceIdentityMap {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  mallUserId String   @unique
  linkedBy   String
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntegrationConfig {
  id            String           @id @default(uuid()) @db.Uuid
  key           String           @unique
  state         IntegrationState @default(UNCONFIGURED)
  publicConfig  Json
  secretRef     String?
  lastCheckedAt DateTime?
  lastError     String?
  updatedAt     DateTime         @updatedAt
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  username     String         @unique
  displayName  String
  passwordHash String
  role         AdminRole
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorType  String
  actorId    String
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  requestId  String?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  scope        String
  key          String
  requestHash  String
  responseCode Int
  responseBody Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

model AccountDeletionRequest {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  status        AccountDeletionStatus @default(REQUESTED)
  requestedAt   DateTime              @default(now())
  executeAfter  DateTime
  completedAt   DateTime?
  failureReason String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, executeAfter])
}

model AppSetting {
  key       String   @id
  value     Json
  public    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model MigrationRun {
  id           String              @id @default(uuid()) @db.Uuid
  sourceLabel  String
  sourceDigest String?
  status       MigrationRunStatus  @default(PLANNED)
  startedAt    DateTime?
  completedAt  DateTime?
  report       Json?
  createdAt    DateTime            @default(now())
  conflicts    MigrationConflict[]
}

model MigrationConflict {
  id         String       @id @default(uuid()) @db.Uuid
  runId      String       @db.Uuid
  entityType String
  legacyId   String
  reason     String
  snapshot   Json
  resolution String?
  resolvedAt DateTime?
  run        MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, entityType, legacyId])
}
